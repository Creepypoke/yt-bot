BOT_TOKEN=1234567890:replace_with_real_token
LOG_LEVEL=info
DOWNLOAD_DIR=./downloads
# Maximum downloaded video size in bytes (50 MB by default).
MAX_FILE_SIZE=50000000
# Transcode every video to MP4 with a maximum width of 480 pixels.
COMPRESS_TO_480P=true
HEALTHCHECK_PORT=3000
# Delay before retrying Telegram long polling after a temporary API error.
TELEGRAM_POLL_RETRY_MS=5000
# Comma-separated Telegram user IDs authorized to run /restart.
BOT_ADMIN_IDS=235306574
# Optional Netscape-format cookies file for private/restricted Instagram posts.
# INSTAGRAM_COOKIES=/absolute/path/to/cookies.txt
# Optional proxy used only by gallery-dl. SOCKS5 example:
# INSTAGRAM_PROXY=socks5://user:password@proxy.example.com:1080
# Optional Netscape-format cookies file for private/restricted YouTube videos.
# YOUTUBE_COOKIES=/absolute/path/to/cookies.txt
# Optional proxy used only by yt-dlp. Use socks5h to resolve DNS through proxy:
# YOUTUBE_PROXY=socks5h://user:password@proxy.example.com:1080
# URL of a bgutil-ytdlp-pot-provider service for YouTube PO tokens.
# Required for reliable YouTube downloads from server IPs. Compose configures it.
# YOUTUBE_POT_PROVIDER_URL=http://pot-provider:4416
